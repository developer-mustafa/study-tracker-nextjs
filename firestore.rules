rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['mustafa.rahman.official@gmail.com', 'mustafarahman792@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isUserBlocked(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('isBlocked', false) == true;
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 200 &&
        data.role in ['student', 'platform_admin', 'admin'] &&
        data.subscriptionTier in ['free', 'pro', 'premium', 'academy'];
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming(), userId);
      allow update: if isPlatformAdmin() || (
        isOwner(userId) &&
        !isUserBlocked(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().isBlocked == existing().get('isBlocked', false)
      );
      allow delete: if isPlatformAdmin();

      // Subjects Subcollection
      match /subjects/{subjectId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && !isUserBlocked(userId) && isValidId(subjectId) &&
          incoming().userId == userId &&
          incoming().name is string && incoming().name.size() <= 100 &&
          incoming().color is string && incoming().color.size() <= 32;
        allow update: if isOwner(userId) && !isUserBlocked(userId) &&
          incoming().userId == existing().userId &&
          incoming().name is string && incoming().name.size() <= 100;
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && !isUserBlocked(userId) && isValidId(taskId) &&
          incoming().userId == userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow update: if isOwner(userId) && !isUserBlocked(userId) &&
          incoming().userId == existing().userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }

      // Study Plans Subcollection
      match /studyPlans/{planId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && !isUserBlocked(userId) && isValidId(planId) &&
          incoming().userId == userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow update: if isOwner(userId) && !isUserBlocked(userId) &&
          incoming().userId == existing().userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }

      // Focus Sessions Subcollection
      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && !isUserBlocked(userId) && isValidId(sessionId) &&
          incoming().userId == userId &&
          incoming().actualDurationSeconds is number;
        allow update: if false; // Sessions are immutable audit history
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if isOwner(userId) && !isUserBlocked(userId) && isValidId(noteId) &&
          incoming().userId == userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow update: if isOwner(userId) && !isUserBlocked(userId) &&
          incoming().userId == existing().userId &&
          incoming().title is string && incoming().title.size() <= 200;
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }

      // Achievements Subcollection
      match /achievements/{achievementId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create, update: if isOwner(userId) && !isUserBlocked(userId) && isValidId(achievementId) &&
          incoming().title is string && incoming().title.size() <= 100;
        allow delete: if false;
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isPlatformAdmin();
        allow create: if (isOwner(userId) && !isUserBlocked(userId)) || isPlatformAdmin();
        allow update: if isOwner(userId) &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isOwner(userId) || isPlatformAdmin();
      }
    }

    // Multi-tenant Organizations
    match /tenants/{tenantId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(tenantId) &&
        (incoming().ownerId == request.auth.uid || isPlatformAdmin());
      allow update: if isPlatformAdmin() || (
        isSignedIn() && existing().ownerId == request.auth.uid
      );
      allow delete: if isPlatformAdmin();

      // Tenant Members
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isPlatformAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid ||
            request.auth.uid == incoming().userId
          )
        );
        allow delete: if isPlatformAdmin() || (
          isSignedIn() && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
        );
      }
    }

    // Payment Gateways (bKash, Nagad, Rocket)
    match /payment_gateways/{gatewayId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // Subscription Plans Maintainer
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // Payment Transactions & Approvals
    match /payment_transactions/{txId} {
      allow get, list: if isSignedIn() && (
        isPlatformAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(txId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';
      allow update, delete: if isPlatformAdmin();
    }

    // Platform Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
