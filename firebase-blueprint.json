{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data stored at users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "studyLevel": { "type": "string", "enum": ["school", "college", "university", "admission", "job_seeker", "programming", "self_learner"] },
        "primaryGoal": { "type": "string", "maxLength": 300 },
        "timezone": { "type": "string", "maxLength": 64 },
        "themePreference": { "type": "string", "enum": ["light", "dark", "system"] },
        "dailyGoalMinutes": { "type": "number" },
        "weeklyGoalMinutes": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "role": { "type": "string", "enum": ["student", "platform_admin", "admin"] },
        "isBlocked": { "type": "boolean" },
        "blockedReason": { "type": "string", "maxLength": 500 },
        "blockedAt": { "type": "string", "format": "date-time" },
        "activeTenantId": { "type": "string", "maxLength": 128 },
        "subscriptionTier": { "type": "string", "enum": ["free", "pro", "premium", "academy"] },
        "subscriptionStatus": { "type": "string", "enum": ["free", "active", "trialing", "past_due", "canceled", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "subscriptionTier"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant organization (academy, coaching, study group)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["academy", "coaching", "study_group", "institution", "personal"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "subscriptionPlanId": { "type": "string", "maxLength": 64 },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trialing", "expired", "suspended"] },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "planExpiresAt": { "type": "string", "format": "date-time" },
        "maxMembers": { "type": "number" },
        "memberCount": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "suspendedReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "ownerId", "subscriptionPlanId", "subscriptionStatus"]
    },
    "TenantMember": {
      "title": "TenantMember",
      "description": "Tenant membership association",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["owner", "admin", "mentor", "student"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "userId", "role", "joinedAt"]
    },
    "PaymentGatewayConfig": {
      "title": "PaymentGatewayConfig",
      "description": "Configuration for bKash, Nagad, and Rocket gateways managed by Platform Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["bkash", "nagad", "rocket"] },
        "name": { "type": "string", "maxLength": 50 },
        "banglaName": { "type": "string", "maxLength": 50 },
        "accountType": { "type": "string", "enum": ["merchant", "personal", "agent"] },
        "accountNumber": { "type": "string", "maxLength": 30 },
        "isActive": { "type": "boolean" },
        "instructions": { "type": "string", "maxLength": 1000 },
        "feePercentage": { "type": "number" },
        "color": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "accountType", "accountNumber", "isActive"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "SaaS subscription plan maintained dynamically by Platform Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 250 },
        "priceMonthly": { "type": "number" },
        "priceYearly": { "type": "number" },
        "maxStudents": { "type": "number" },
        "maxStudyPlans": { "type": "number" },
        "popular": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "btnLabel": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "priceMonthly", "priceYearly", "isActive"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Payment transaction record submitted by tenant/user via bKash/Nagad/Rocket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "tenantName": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "gateway": { "type": "string", "enum": ["bkash", "nagad", "rocket"] },
        "senderNumber": { "type": "string", "maxLength": 30 },
        "trxId": { "type": "string", "maxLength": 64 },
        "planId": { "type": "string", "maxLength": 64 },
        "planName": { "type": "string", "maxLength": 100 },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "approvedBy": { "type": "string", "maxLength": 200 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "gateway", "senderNumber", "trxId", "planId", "amount", "status"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Study subject entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 32 },
        "icon": { "type": "string", "maxLength": 64 },
        "targetMinutes": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "color", "targetMinutes"]
    },
    "Task": {
      "title": "Task",
      "description": "Study task entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "studyPlanId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "cancelled"] },
        "deadline": { "type": "string", "maxLength": 64 },
        "estimatedMinutes": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "priority", "status"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Study roadmap and syllabus plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string", "maxLength": 64 },
        "targetDate": { "type": "string", "maxLength": 64 },
        "targetMinutes": { "type": "number" },
        "completedMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["planned", "in_progress", "completed", "paused"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status"]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "Individual recorded focus session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["focus", "short_break", "long_break", "custom"] },
        "plannedDurationMinutes": { "type": "number" },
        "actualDurationSeconds": { "type": "number" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "subjectId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "mode", "actualDurationSeconds", "startTime", "endTime", "isCompleted"]
    },
    "Note": {
      "title": "Note",
      "description": "Student revision note",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 20000 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "content"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Awarded badge/achievement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "icon": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["sessions", "streak", "hours", "tasks", "plans"] },
        "requiredCount": { "type": "number" },
        "isUnlocked": { "type": "boolean" },
        "progress": { "type": "number" }
      },
      "required": ["id", "title", "requiredCount", "isUnlocked"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["reminder", "session_completed", "deadline", "goal_achieved", "achievement_unlocked", "subscription_update", "payment_status"] },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 500 },
        "isRead": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "title", "message", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile, block status, and preferences"
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Multi-tenant organizations and academies"
    },
    "/tenants/{tenantId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/TenantMember" },
      "description": "Members assigned to a tenant organization"
    },
    "/payment_gateways/{gatewayId}": {
      "schema": { "$ref": "#/entities/PaymentGatewayConfig" },
      "description": "bKash, Nagad, and Rocket gateway configs managed by Platform Admin"
    },
    "/subscription_plans/{planId}": {
      "schema": { "$ref": "#/entities/SubscriptionPlan" },
      "description": "SaaS subscription plans maintained by Platform Admin"
    },
    "/payment_transactions/{txId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Payment requests and TrxID submissions for bKash/Nagad/Rocket"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects managed by the user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks created and tracked by user"
    },
    "/users/{userId}/studyPlans/{planId}": {
      "schema": { "$ref": "#/entities/StudyPlan" },
      "description": "User study plans and roadmaps"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FocusSession" },
      "description": "Recorded focus and study sessions"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Study revision notes"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/Achievement" },
      "description": "Unlocked and in-progress user achievements"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User in-app notifications"
    }
  }
}
